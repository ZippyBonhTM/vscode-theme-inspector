{
  "name": "vscode-theme-inspector-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo workspace root for VS Code Theme Inspector.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:core": "npm run build -w packages/core",
    "build:extension": "npm run build -w apps/vscode-extension",
    "build": "npm run build:core && npm run build:extension",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:core": "npm run test -w packages/core",
    "test:extension": "npm run build:core && npm run build:extension && npm run test -w apps/vscode-extension",
    "test": "npm run test:core && npm run test:extension"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
