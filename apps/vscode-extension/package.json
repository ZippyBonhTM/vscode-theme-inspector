{
  "name": "vscode-theme-inspector",
  "displayName": "Theme Inspector",
  "description": "Inspect and resolve VS Code Theme Color IDs behind the Workbench UI. Early development — architecture and functionality are subject to change.",
  "version": "0.0.1",
  "private": true,
  "publisher": "vscode-theme-inspector",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "themeInspector",
          "title": "Theme Inspector",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "themeInspector": [
        {
          "type": "webview",
          "id": "themeInspector.view",
          "name": "Theme Inspector"
        }
      ]
    },
    "commands": [
      {
        "command": "themeInspector.turnOn",
        "title": "Theme Inspector: Turn On"
      },
      {
        "command": "themeInspector.turnOff",
        "title": "Theme Inspector: Turn Off"
      },
      {
        "command": "themeInspector.toggleInspector",
        "title": "Theme Inspector: Toggle Inspector"
      },
      {
        "command": "themeInspector.openThemeColorExplorer",
        "title": "Theme Inspector: Open Theme Color Explorer"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vscode-test"
  },
  "dependencies": {
    "@vscode-theme-inspector/core": "*",
    "@vscode-theme-inspector/theme-colors": "*"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0"
  }
}
